cc_binary {
    name: "vendor.dolby.media.c2@1.0-service",
    stem: "vendor.dolby.media.c2@1.0-service",
    owner: "aospa",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.media.c2@1.0",
        "libbase",
        "libbinder",
        "libcodec2",
        "libcodec2_hidl@1.0",
        "libcodec2_store_dolby",
        "libcodec2_vndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    cpp_std: "c++17",
    stl: "c++_shared",
}
