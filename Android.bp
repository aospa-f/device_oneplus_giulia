soong_namespace {
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/kiwi_v2/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/WCNSS_qcom_cfg.ini",
    symlink_target: "/odm/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "libui-stock_symlink",
    vendor: true,
    installed_location: "lib64/libui-stock.so",
    symlink_target: "libui.so",
}

prebuilt_etc_xml {
    name: "manifest_oplusSensor_aidl.xml",
    src: "manifest_oplusSensor_aidl.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    device_specific: true,
}

cc_prebuilt_library_shared {
    name: "libiccprofile",
    owner: "oneplus",
    strip: {
        none: true,
    },
    check_elf_files: false,
    target: {
        android_arm64: {
            srcs: [
                "prebuilts/libiccprofile.so",
            ],
        },
    },
    compile_multilib: "64",
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "liboemcrypto",
    owner: "oneplus",
    strip: {
        none: true,
    },
    check_elf_files: false,
    target: {
        android_arm64: {
            srcs: [
                "prebuilts/liboemcrypto.so",
            ],
        },
    },
    compile_multilib: "64",
    device_specific: true,
}

cc_prebuilt_binary {
    name: "vendor-oplus-hardware-oplusSensor-V1-service",
    owner: "oneplus",
    strip: {
        none: true,
    },
    check_elf_files: false,
    target: {
        android_arm64: {
            srcs: [
                "prebuilts/vendor-oplus-hardware-oplusSensor-V1-service",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "hw",
    device_specific: true,
}

cc_prebuilt_binary {
    name: "vendor.oplus.hardware.biometrics.face@1.0-service_uff",
    owner: "oneplus",
    strip: {
        none: true,
    },
    check_elf_files: false,
    target: {
        android_arm64: {
            srcs: [
                "prebuilts/vendor.oplus.hardware.biometrics.face@1.0-service_uff",
            ],
            shared_libs: [
                "android.hardware.biometrics.common-V3-ndk",
                "android.hardware.biometrics.face-V3-ndk",
                "libcamera2ndk_vendor",
                "libstfaceunlockocl_uff",
            ],
        },
    },
    compile_multilib: "64",
    relative_install_path: "hw",
    device_specific: true,
}

cc_prebuilt_library_shared {
    name: "libstfaceunlockocl_uff",
    owner: "oneplus",
    strip: {
        none: true,
    },
    check_elf_files: false,
    target: {
        android_arm64: {
            srcs: [
                "prebuilts/libstfaceunlockocl_uff.so",
            ],
        },
    },
    compile_multilib: "64",
    device_specific: true,
}

prebuilt_etc_xml {
    name: "manifest_oplus_face.xml",
    src: "manifest_oplus_face.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    device_specific: true,
}
